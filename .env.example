# MetaVisage build configuration template
#
# Copy this file to one of:
#   .env.development   (committed; local-dev defaults -- localhost web portal)
#   .env.staging       (gitignored; staging values from the web team)
#   .env.production    (gitignored; production values from the web team)
#
# The PowerShell helpers (build-msvc.ps1 / build-mingw.ps1 -Profile <name>)
# read .env.<profile> and pass each KEY=VALUE pair through to CMake as a -D
# cache variable. The values are baked into the binary at configure time.
#
# Lines starting with `#` and blank lines are skipped. Surrounding single or
# double quotes around a value are stripped.

# ---------------------------------------------------------------------------
# Web portal API base URL (no trailing slash).
#
# development: http://localhost:3000
# staging:     https://staging.metavisage.io
# production:  https://metavisage.io
# ---------------------------------------------------------------------------
METAVISAGE_API_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase project URL -- used for the access-token refresh endpoint per
# DESKTOP_INTEGRATION_QA.md Decision 2 / Option A. Looks like:
#   https://<project-ref>.supabase.co
# ---------------------------------------------------------------------------
METAVISAGE_SUPABASE_PROJECT_URL=https://your-project.supabase.co

# ---------------------------------------------------------------------------
# Supabase NEXT_PUBLIC anon key. Designed to be client-distributable, so
# safe to embed in the desktop binary. Will be delivered alongside the
# project URL in the web team's 1Password drop.
# ---------------------------------------------------------------------------
METAVISAGE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# RS256 license JWT public key (PEM, SPKI format). Path is relative to the
# project root unless absolute. The build reads the file at configure time
# and bakes the contents into the generated LicenseConfig.h header.
#
# Drop the .pem file under keys/ and reference it here. Never commit a
# private key. keys/ is gitignored except for README.md and .gitkeep.
# ---------------------------------------------------------------------------
METAVISAGE_LICENSE_JWT_PUBLIC_KEY_FILE=keys/development-public.pem
