# Build directories
build/
bin/
lib/
*.exe
*.dll
*.so
*.dylib

# Qt MOC files
moc_*.cpp
ui_*.h
qrc_*.cpp

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake

# IDE files
.vscode/
.idea/
*.pro.user
*.vcxproj
*.vcxproj.filters
*.sln

# Compiler output
*.o
*.a
*.lib

# Temporary files
*.tmp
*.log
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Project files
*.mmproj
*.autosave
# Test fixtures are an exception — they pin the v1.0.0 schema for the
# backward-compat regression in tests/smoke/v1_backward_compat.cpp.
!tests/fixtures/*.mmproj

# User config
config.ini
.settings

# Claude Code runtime artifacts (per-session session ID + PID)
.claude/scheduled_tasks.lock

# Licensing / auth configuration (Sprint 6)
# .env.example and .env.development are checked in; everything else stays
# local. keys/*.pem holds RS256 license JWT public keys per environment —
# never committed.
.env
.env.local
.env.staging
.env.production
keys/*.pem