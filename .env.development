# Local-development build configuration (Sprint 6 Story 6.1+)
#
# Active when running:
#   .\build-msvc.ps1 -Profile development   (default)
#
# Points the desktop at the local Next.js dev server. Supabase project URL
# and the NEXT_PUBLIC anon key are intentionally client-distributable (per
# the web team's QA doc) so they live in the committed dev profile. The
# RS256 public key file under keys/ is gitignored and dropped manually.

METAVISAGE_API_BASE_URL=http://localhost:3000

METAVISAGE_SUPABASE_PROJECT_URL=https://kkfybpsqqhnzvebzvqrc.supabase.co
